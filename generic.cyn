// Clase genérica simple
class Box<T> {
    public T value;
    public Box(T v) { this.value = v; }
    public T get() { return this.value; }
}

// struct genérico (por valor)
struct Pair<T> {
    T first;
    T second;
}

// Herencia genérica
class Animal { public string name; }
class Dog : Animal { public void bark() { } }

class Container<T: Animal> {
    public T item;
    public Container(T i) { this.item = i; }
}

// Instanciación
class Main {
    public static void main() {
        Box<int> b = new Box<int>(42);
        Box<string> s = new Box<string>("hola");

        Pair<int> p;         // alloc en stack
        p.first = 1;
        p.second = 2;

        Container<Dog> c = new Container<Dog>(new Dog());

        System.println(b.get());   // 42
        System.println(s.get());   // hola
    }
}