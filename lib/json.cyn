// lib/json.cyn
// Parser + writer JSON en Cyn puro.

namespace json {

    class Value {
        public static int KIND_NULL()   { return 0; }
        public static int KIND_FALSE()  { return 1; }
        public static int KIND_TRUE()   { return 2; }
        public static int KIND_NUMBER() { return 3; }
        public static int KIND_STRING() { return 4; }
        public static int KIND_ARRAY()  { return 5; }
        public static int KIND_OBJECT() { return 6; }

        public static int kindOf(ptr v) {
            return Unsafe.pointer.read32(v);
        }
        public static string strOf(ptr v) {
            return Unsafe.pointer.read32(Unsafe.pointer.offset(v, 4)) as string;
        }
        public static ptr itemsOf(ptr v) {
            return Unsafe.pointer.read32(Unsafe.pointer.offset(v, 8));
        }
        public static ptr keysOf(ptr v) {
            return Unsafe.pointer.read32(Unsafe.pointer.offset(v, 12));
        }
        public static int countOf(ptr v) {
            return Unsafe.pointer.read32(Unsafe.pointer.offset(v, 16));
        }

        public static ptr alloc(int kind) {
            ptr p = Unsafe.memory.alloc(20);
            Unsafe.memory.set(p, 0, 20);
            Unsafe.pointer.write32(p, kind);
            return p;
        }
        public static void setStr(ptr v, string s) {
            Unsafe.pointer.write32(Unsafe.pointer.offset(v, 4), s as int);
        }
        public static void setItems(ptr v, ptr p) {
            Unsafe.pointer.write32(Unsafe.pointer.offset(v, 8), p);
        }
        public static void setKeys(ptr v, ptr p) {
            Unsafe.pointer.write32(Unsafe.pointer.offset(v, 12), p);
        }
        public static void setCount(ptr v, int n) {
            Unsafe.pointer.write32(Unsafe.pointer.offset(v, 16), n);
        }

        public static ptr getItem(ptr items, int i) {
            return Unsafe.pointer.read32(Unsafe.pointer.offset(items, i * 4));
        }
        public static void setItem(ptr items, int i, ptr child) {
            Unsafe.pointer.write32(Unsafe.pointer.offset(items, i * 4), child);
        }
        public static string keyAt(ptr keys, int i) {
            return Unsafe.pointer.read32(Unsafe.pointer.offset(keys, i * 4)) as string;
        }
        public static void setKeyAt(ptr keys, int i, string s) {
            Unsafe.pointer.write32(Unsafe.pointer.offset(keys, i * 4), s as int);
        }

        public static bool asBool(ptr v) {
            return kindOf(v) == KIND_TRUE();
        }
        public static string asString(ptr v) {
            return strOf(v);
        }
        public static double asNumber(ptr v) {
            return StringUtil.parseDouble(strOf(v));
        }
        public static ptr at(ptr v, int i) {
            return getItem(itemsOf(v), i);
        }
        public static ptr getKey(ptr v, string k) {
            int n = countOf(v);
            ptr keys = keysOf(v);
            ptr items = itemsOf(v);
            for (int i = 0; i < n; i = i + 1) {
                if (keyAt(keys, i) == k) return getItem(items, i);
            }
            return 0;
        }
    }

    class Parser {
        string src;
        int pos;
        int len;

        public Parser(string s) {
            this.src = s;
            this.pos = 0;
            this.len = s.length;
        }

        public static ptr parse(string s) {
            Parser p = new Parser(s);
            return p.parseValue();
        }

        int peek() {
            if (this.pos >= this.len) return -1;
            return Unsafe.pointer.read8(Unsafe.pointer.offset(this.src, this.pos));
        }

        void skip() {
            while (this.pos < this.len) {
                int c = this.peek();
                if (c == 32 || c == 9 || c == 10 || c == 13) this.pos = this.pos + 1;
                else return;
            }
        }

        public ptr parseValue() {
            this.skip();
            int c = this.peek();
            if (c == -1) return 0;
            if (c == 110) { this.pos = this.pos + 4; return 0; }
            if (c == 116) { this.pos = this.pos + 4; return Value.alloc(Value.KIND_TRUE()); }
            if (c == 102) { this.pos = this.pos + 5; return Value.alloc(Value.KIND_FALSE()); }
            if (c == 34)  return this.parseStr();
            if (c == 91)  return this.parseArr();
            if (c == 123) return this.parseObj();
            if (c == 45 || (c >= 48 && c <= 57)) return this.parseNum();
            return 0;
        }

        ptr parseStr() {
            this.pos = this.pos + 1;
            int start = this.pos;
            while (this.pos < this.len) {
                int c = this.peek();
                if (c == 34) break;
                if (c == 92) this.pos = this.pos + 2;
                else this.pos = this.pos + 1;
            }
            int end = this.pos;
            this.pos = this.pos + 1;
            ptr v = Value.alloc(Value.KIND_STRING());
            Value.setStr(v, StringUtil.byteSubstring(this.src, start, end - start));
            return v;
        }

        ptr parseNum() {
            int start = this.pos;
            if (this.peek() == 45) this.pos = this.pos + 1;
            while (this.pos < this.len) {
                int c = this.peek();
                if ((c >= 48 && c <= 57) || c == 46 || c == 101 || c == 69 || c == 43 || c == 45) this.pos = this.pos + 1;
                else break;
            }
            ptr v = Value.alloc(Value.KIND_NUMBER());
            Value.setStr(v, StringUtil.byteSubstring(this.src, start, this.pos - start));
            return v;
        }

        ptr parseArr() {
            this.pos = this.pos + 1;
            ptr v = Value.alloc(Value.KIND_ARRAY());
            Value.setItems(v, Unsafe.memory.alloc(4));
            Value.setCount(v, 0);
            this.skip();
            if (this.peek() == 93) { this.pos = this.pos + 1; return v; }
            while (true) {
                ptr item = this.parseValue();
                int n = Value.countOf(v);
                ptr oldArr = Value.itemsOf(v);
                ptr newArr = Unsafe.memory.alloc((n + 1) * 4);
                for (int i = 0; i < n; i = i + 1) Value.setItem(newArr, i, Value.getItem(oldArr, i));
                Value.setItem(newArr, n, item);
                Value.setItems(v, newArr);
                Value.setCount(v, n + 1);
                this.skip();
                if (this.peek() == 44) { this.pos = this.pos + 1; continue; }
                break;
            }
            this.skip();
            if (this.peek() == 93) this.pos = this.pos + 1;
            return v;
        }

        ptr parseObj() {
            this.pos = this.pos + 1;
            ptr v = Value.alloc(Value.KIND_OBJECT());
            Value.setItems(v, Unsafe.memory.alloc(4));
            Value.setKeys(v, Unsafe.memory.alloc(4));
            Value.setCount(v, 0);
            this.skip();
            if (this.peek() == 125) { this.pos = this.pos + 1; return v; }
            while (true) {
                this.skip();
                ptr keyV = this.parseStr();
                string key = Value.strOf(keyV);
                this.skip();
                if (this.peek() != 58) break;
                this.pos = this.pos + 1;
                ptr item = this.parseValue();
                int n = Value.countOf(v);
                ptr oldItems = Value.itemsOf(v);
                ptr oldKeys = Value.keysOf(v);
                ptr newItems = Unsafe.memory.alloc((n + 1) * 4);
                ptr newKeys = Unsafe.memory.alloc((n + 1) * 4);
                for (int i = 0; i < n; i = i + 1) {
                    Value.setItem(newItems, i, Value.getItem(oldItems, i));
                    Value.setKeyAt(newKeys, i, Value.keyAt(oldKeys, i));
                }
                Value.setItem(newItems, n, item);
                Value.setKeyAt(newKeys, n, key);
                Value.setItems(v, newItems);
                Value.setKeys(v, newKeys);
                Value.setCount(v, n + 1);
                this.skip();
                if (this.peek() == 44) { this.pos = this.pos + 1; continue; }
                break;
            }
            this.skip();
            if (this.peek() == 125) this.pos = this.pos + 1;
            return v;
        }
    }

    class Write {
        public static string serialize(ptr v) {
            if (v == 0) return "null";
            int k = Value.kindOf(v);
            if (k == Value.KIND_NULL())   return "null";
            if (k == Value.KIND_FALSE())  return "false";
            if (k == Value.KIND_TRUE())   return "true";
            if (k == Value.KIND_NUMBER()) return Value.strOf(v);
            if (k == Value.KIND_STRING()) return "\"" + Value.strOf(v) + "\"";
            if (k == Value.KIND_ARRAY()) {
                string r = "[";
                int n = Value.countOf(v);
                ptr items = Value.itemsOf(v);
                for (int i = 0; i < n; i = i + 1) {
                    if (i > 0) r = r + ",";
                    r = r + Write.serialize(Value.getItem(items, i));
                }
                return r + "]";
            }
            string r2 = "{";
            int n2 = Value.countOf(v);
            ptr items2 = Value.itemsOf(v);
            ptr keys2 = Value.keysOf(v);
            for (int i = 0; i < n2; i = i + 1) {
                if (i > 0) r2 = r2 + ",";
                r2 = r2 + "\"" + Value.keyAt(keys2, i) + "\"" + ":" + Write.serialize(Value.getItem(items2, i));
            }
            return r2 + "}";
        }

        public static string pretty(ptr v) {
            return Write.prettyRec(v, 0);
        }

        static string prettyRec(ptr v, int indent) {
            if (v == 0) return "null";
            int k = Value.kindOf(v);
            if (k == Value.KIND_NULL())   return "null";
            if (k == Value.KIND_FALSE())  return "false";
            if (k == Value.KIND_TRUE())   return "true";
            if (k == Value.KIND_NUMBER()) return Value.strOf(v);
            if (k == Value.KIND_STRING()) return "\"" + Value.strOf(v) + "\"";

            string indentStr = "";
            for (int i = 0; i < indent; i = i + 1) indentStr = indentStr + "  ";
            string nextIndent = indentStr + "  ";

            if (k == Value.KIND_ARRAY()) {
                int n = Value.countOf(v);
                if (n == 0) return "[]";
                string r = "[\n";
                ptr items = Value.itemsOf(v);
                for (int i = 0; i < n; i = i + 1) {
                    r = r + nextIndent + Write.prettyRec(Value.getItem(items, i), indent + 1);
                    if (i < n - 1) r = r + ",";
                    r = r + "\n";
                }
                return r + indentStr + "]";
            }
            int n2 = Value.countOf(v);
            if (n2 == 0) return "{}";
            string r2 = "{\n";
            ptr items2 = Value.itemsOf(v);
            ptr keys2 = Value.keysOf(v);
            for (int i = 0; i < n2; i = i + 1) {
                r2 = r2 + nextIndent + "\"" + Value.keyAt(keys2, i) + "\": " + Write.prettyRec(Value.getItem(items2, i), indent + 1);
                if (i < n2 - 1) r2 = r2 + ",";
                r2 = r2 + "\n";
            }
            return r2 + indentStr + "}";
        }
    }
}

using json;