enum Color { Red, Verde, Azul }
enum Flags { READ = 1, WRITE = 2, EXEC = 4 }

class Colores {
    public static int Red = 1;
    public static int Verde = 2;
    public static int Azul = 3;
    private Colores() {}
}

class Persona {
    static void main() {
        System.println("Color.Verde =", Color.Verde);       // ordinal 1
        System.println("Flags.EXEC  =", Flags.EXEC);        // ordinal 4
        System.println("Colores.Azul=", Colores.Azul);      // static int 3
        System.println("hex  =", 0xFF);                     // 255
        System.println("bin  =", 0b1010);                   // 10
        // Color c = 1;   // ❌ error semántico (int → Color)
        // c == 1         // ❌ error semántico
    }
}

